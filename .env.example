# Docker local: copy this file to .env. Guest mode works without Firebase.
PORT=3002
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost,https://localhost,capacitor://localhost
FIREBASE_PROJECT_ID=
# Docker only; uncomment after adding your own service-account file:
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-admin.json
VITE_API_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Cloud backend only. Generate a secret of at least 32 characters before use.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
GUEST_SECRET=
REDIS_NAMESPACE=rift-cloud-v1
# Vercel: set FIREBASE_SERVICE_ACCOUNT_JSON in the dashboard, not in source code.
