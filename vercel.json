{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "client",
      "framework": "vite",
      "installCommand": "npm ci --prefix ..",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    },
    "backend": {
      "root": "server",
      "framework": "express",
      "entrypoint": "vercel.mjs",
      "installCommand": "npm ci --prefix ..",
      "functions": {
        "**/*.mjs": {
          "maxDuration": 300
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/socket.io/:path*",
      "destination": {
        "service": "backend",
        "path": "/api/health"
      }
    },
    {
      "source": "/",
      "destination": {
        "service": "web",
        "path": "/index.html"
      }
    },
    {
      "source": "/:path*",
      "destination": {
        "service": "web"
      }
    }
  ]
}